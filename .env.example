# bnbulls — env template. NEVER commit the real .env (see .gitignore).
# Real key material lives OUTSIDE this repo, in ~/.claude/secrets/.
#
# ─────────────────────────────────────────────────────────────────────────
# HOW THE CHAIN PROFILES WORK
# ─────────────────────────────────────────────────────────────────────────
# Every external address is read as `NAME` on mainnet and `NAME_TESTNET` on
# chain 97 (`BnbullsConfig._chainAddr`). The two blocks are never both live,
# so an operator editing the wrong one gets a "missing env var" by name
# instead of a rehearsal quietly wired to mainnet contracts.
#
# Deployment records are separated the same way:
#   deployments/56.json   mainnet    (commit it)
#   deployments/97.json   testnet    (commit it)
#   .state/anvil/…        local      (gitignored)
# NOTHING is ever written back into this file. That is the fix for the $154
# loss in DEPLOY-SAFETY-PREFLIGHT §1: a rehearsal cannot poison real config
# if it cannot reach the file.

# ── chain ────────────────────────────────────────────────────────────────
CHAIN_ID=56
# primary must be keyed or publicnode — NEVER the bare dataseed at scale.
# no pay-as-you-go providers.
RPC_URL=https://bsc-rpc.publicnode.com
RPC_URL_FALLBACK=https://bsc.drpc.org
RPC_URL_TESTNET=https://bsc-testnet-rpc.publicnode.com
EXPLORER_BASE_URL=https://bscscan.com
EXPLORER_BASE_URL_TESTNET=https://testnet.bscscan.com
ETHERSCAN_API_KEY=

# ── bnb chain MAINNET addresses (✔ confirmed — re-verify at kickoff) ─────
WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# ⚠ THE ONLY VENUE THE CONTRACTS TRADE ON — `DECISIONS.md §28`. MintDrop AND
# both splitters wire this one router, and each derives the pair (and therefore
# the liquidity floor) from its own `factory()`. There is deliberately NO
# separate factory wire: a second address is one more way to price off a
# different book than the one the swap hits.
PANCAKE_V2_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
# ⚠ NOT WIRED INTO ANY CONTRACT. Read only so the deploy record names it.
PANCAKE_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
# ⚠ NOTHING SWAPS ON v3. four.meme creates ZERO v3 pools at any tier, so the
# only pool a v3 leg could ever find is a stranger's decoy. Kept for the record.
PANCAKE_V3_FACTORY=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
PANCAKE_V3_SMART_ROUTER=0x13f4EA83D0bd40E75C8222255bc855a974568Dd4
# ⚠ VERIFY on developer.pancakeswap.finance/contracts/v3/addresses
PANCAKE_V3_QUOTER_V2=
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# chainlink — option A pricing reads this feed at pay time
CHAINLINK_BNB_USD=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
CHAINLINK_VRF_COORDINATOR=0xd691f04bc0C9a24Edb78af9E005Cf85768F694C9
LINK_TOKEN=0x404460C6A5EdE2D891e8297795264fDe62ADBB75
VRF_KEY_HASH_200GWEI=0x130dba50ad435d4ecc214aad0d5820474137bd68e7e77724144f27c3c377d3d4
VRF_SUBSCRIPTION_ID=

# ⚠ THE PAYMENT STABLECOIN IS GONE (`DECISIONS.md §26`). BNB and BNBULL are
# the only two payment currencies, so STABLECOIN / STABLECOIN_DECIMALS are no
# longer read by anything. The read-never-assume rule they existed for now
# applies to BNBULL, whose decimals four.meme decides — every contract reads
# `decimals()` off the wire at wiring time and none of them is configured here.

# ── bnb chain TESTNET addresses (chain 97) ───────────────────────────────
# ⚠ EVERY ONE OF THESE WAS PROVEN ON CHAIN 97 BEFORE IT WAS WRITTEN HERE,
#   not copied from a blog. The proof for each, run against
#   https://bsc-testnet-rpc.publicnode.com on 2026-08-06:
#
#   WBNB_TESTNET
#     NOT looked up at all — DISCOVERED on chain by calling WETH() on the v2
#     router below, so it is by construction the WBNB that router uses.
#     name() = "Wrapped BNB", symbol() = "WBNB", decimals() = 18.
#     Cross-checked: the v3 SmartRouter's WETH9() returns the SAME address.
#
#   PANCAKE_V2_ROUTER_TESTNET
#     Source: BNB Chain's own example-hub repo (github.com/bnb-chain).
#     cast code -> 35,879 hex chars. WETH() and factory() both answer;
#     factory() -> 0xB7926C0430Afb07AA7DEfDE6DA862aE0Bde767bc, whose
#     INIT_CODE_PAIR_HASH() is 0xecba335299a6693cb2ebc4782e74669b84290b63…
#
#   PANCAKE_V3_SMART_ROUTER_TESTNET
#     cast code -> 48,635 hex chars. WETH9() returns the same WBNB as the v2
#     router (the decisive cross-check), and factory() returns
#     0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865 — byte-identical to the
#     mainnet PANCAKE_V3_FACTORY above, which is what a deterministic
#     PancakeSwap v3 deployment should look like.
#
#   CHAINLINK_BNB_USD_TESTNET
#     Source: Chainlink's own reference-data-directory (the feed data their
#     docs render). description() = "BNB / USD", decimals() = 8,
#     latestRoundData() answered 59507581581 (= $595.08) at a fresh
#     timestamp. Heartbeat 3600s, deviation 0.3%.
#
#   CHAINLINK_VRF_COORDINATOR_TESTNET
#     Source: docs.chain.link VRF v2.5 supported-networks.
#     cast code -> 48,191 hex chars. It does not expose typeAndVersion(),
#     but LINK() returns EXACTLY the LINK address the same doc page lists,
#     LINK_NATIVE_FEED() and owner() answer, and s_currentSubNonce() is
#     1398 — a live v2.5 coordinator with 1,398 subscriptions created.
WBNB_TESTNET=0xae13d989daC2f0dEbFf460aC112a837C89BAa7cd
PANCAKE_V2_ROUTER_TESTNET=0x9Ac64Cc6e4415144C455BD8E4837Fea55603e5c3
PANCAKE_V2_FACTORY_TESTNET=0xB7926C0430Afb07AA7DEfDE6DA862aE0Bde767bc
PANCAKE_V3_SMART_ROUTER_TESTNET=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
PANCAKE_V3_FACTORY_TESTNET=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
# ⚠ NOT VERIFIED. QuoterV2 is not reachable from any contract we deploy (the
# splitters use keeper-published floors precisely because v3 has no cheap
# on-chain view quote), so a blank here blocks nothing. Left blank rather
# than guessed.
PANCAKE_V3_QUOTER_V2_TESTNET=

CHAINLINK_BNB_USD_TESTNET=0x2514895c72f50D8bd4B4F9b1110F0D6bD2c97526
CHAINLINK_VRF_COORDINATOR_TESTNET=0xDA3b641D438362C440Ac5458c57e00a712b66700
LINK_TOKEN_TESTNET=0x84b9B910527Ad5C03A9Ca831909E21e236EA7b06
# The only lane testnet publishes: 50 gwei.
VRF_KEY_HASH_TESTNET=0x8596b430971ac45bdf6088665b9ad8e8630c9d5049ab54b14dff711bee7c0e26
# ⚠ MANUAL STEP. Create + fund a subscription at vrf.chain.link (BNB Chain
# Testnet), add BOTH Jackpot addresses as consumers, then put the id here and
# re-run the deploy so setVrfConfig lands. Until then tickets open on every
# decisive duel and requestResolve reverts VrfNotConfigured — fights are
# unaffected, so nothing looks broken and the pot simply never pays.
VRF_SUBSCRIPTION_ID_TESTNET=

# four.meme is mainnet-only, so there is no BNBULL on 97: leave this blank
# and the rehearsal deploys BNBull.sol itself.
BNBULL_TOKEN_TESTNET=

# ── deploy roles ─────────────────────────────────────────────────────────
# ⚠ DEPLOY-SAFETY-PREFLIGHT rule 1: every line below is diffed against the
# DEPLOYER address and the script stops on any mismatch until a human has
# typed that exact address back. "Is it a well-formed address" is the check
# that passed on the wallet that ate 154 USDT. Leave them blank to default to
# the deployer.
OWNER=
KEEPER=
TRUSTED_SIGNER=
# (DEV_WALLET is gone with `DECISIONS.md §31` — `Bulls` no longer has one, and
# the rarity table is immutable from construction. MintDrop's own treasuries
# below are a different thing and are unchanged.)
MINT_TREASURY=
LP_TREASURY=
FEE_TREASURY=
DEV_TREASURY=
RESURRECT_TREASURY=
# prompt | env. `env` needs CONFIRM_<NAME>=<the same address> per foreign line.
TREASURY_CONFIRM_MODE=prompt

# ── deploy guards ────────────────────────────────────────────────────────
# Asserted against the chain behind --rpc-url BEFORE the first broadcast.
# 56 mainnet / 97 testnet / 31337 anvil.
EXPECT_CHAIN_ID=
# Mainnet refuses to broadcast without this. Mainnet also refuses a plaintext
# PRIVATE_KEY outright and requires a keystore (--account + --password-file).
CONFIRM_MAINNET=
USE_KEYSTORE=
# rule 2: copy ~/.foundry/keystores somewhere OFF this box before any run that
# creates or deletes a wallet. A fork rehearsal does both.
KEYSTORE_SNAPSHOT_TAKEN=
# Set true only for the chain-97 pre-liquidity rehearsal, where a non-zero
# deferral bucket is the CORRECT result rather than a wiring bug.
ALLOW_DEFERRALS=

# ── launch numbers (every one is an owner setter with a bound) ───────────
MARKETPLACE_FEE_BPS=750
MARKETPLACE_JACKPOT_FEE_BPS=250
DUEL_DEFAULT_DEV_BPS=1000
BNBULL_SUPPLY=1000000000000000000000000000
NFT_BASE_URI=

# ⚠ PERMANENT. `Duel.addFightAsset` is one-shot per asset and the ceiling can
# never be raised. Required on mainnet, in each asset's OWN units.
FIGHT_MAX_COST_WBNB=
FIGHT_MAX_COST_BNBULL=
# ⚠ THE BNB STAKE IS A DOLLAR FIGURE NOW, 1e18-scaled ($5 = 5000000000000000000)
# — `DECISIONS.md §26`. `FIGHT_COST_WBNB` is RETIRED: `Duel.setFightCost` reverts
# `OraclePricedAsset` on WBNB, because a stored BNB peg with no freshness
# guarantee is exactly the failure `§1` option A exists to prevent. The BNB
# amount is derived from this through the Chainlink feed at read time and needs
# no repegging when BNB moves.
FIGHT_COST_USD=
# BNBULL's own units, at the FULL undiscounted sticker — the contract owns the
# 10% (`§2`), so do NOT pre-discount this or buyers get 19% off.
FIGHT_COST_BNBULL=

# ⚠ THE JACKPOT-TICKET DUST FLOOR, PER ASSET. Required on mainnet.
# `Duel._rollOnePool` refuses a stake of exactly 0, but ONE WEI mints the same
# full-odds ticket and the 10% dev cut truncates to nothing below 10 wei — a
# rake-free ticket against a pot that pays out 100%. This mapping was reachable
# only from the admin UI, so no deploy path ever set it and it read ZERO on
# mainnet.
# Size at ~10% of the LIVE stake in that asset's own units. Both stakes SHRINK
# in token terms as the underlying appreciates (the BNB side is a dollar anchor
# through Chainlink; the BNBULL side is a keeper peg walked down), so a floor
# near today's stake starts silently refusing tickets on ordinary fights the
# moment price moves — `_rollOnePool` just returns and the pot never issues
# again. 10% buys 10x of headroom while still refusing dust by twelve orders of
# magnitude. Bounded above by that asset's `FIGHT_MAX_COST_*`.
MIN_TICKET_STAKE_WBNB=
MIN_TICKET_STAKE_BNBULL=

# ⚠ A ZERO FLOOR DISABLES ITS SWAP LEG. The pre-check fails, the slice defers
# into a pending bucket, and nothing reverts or warns. Quote these off chain
# immediately before the deploy. Required on mainnet.
#   *_PER_BNB    : per 1e18 BNB in
#   *_PER_BNBULL : per ONE WHOLE BNBULL unit in — divided by `10**decimals()`
#                  READ off the token, never by a hardcoded 1e18.
# ⚠ `FLOOR_WBNB_PER_BNBULL` is only ever consulted with `§14`'s never-sell
#   policy switched OFF. Set it anyway: an unset floor is a silent deferral.
FLOOR_BNBULL_PER_BNB=
FLOOR_WBNB_PER_BNBULL=
# ── minimum-liquidity floor (`DECISIONS.md §28`) ─────────────────────────
# Smallest WBNB-side reserve the canonical WBNB/BNBULL **v2** pair may hold and
# still be traded into. Under it — or with no pair at all — every buy leg
# DEFERS and accrues. It never trades and it never reverts.
#
# ⚠ `POOL_FEE_WBNB_BNBULL` IS GONE. It selected a v3 fee tier, and four.meme
# graduates into PancakeSwap **v2**, which has no fee tiers — the pad creates
# ZERO v3 pools at any tier, so the only thing a v3 leg could ever have found
# is somebody else's decoy (measured: 1 BNB bought 112,244 tokens through a
# decoy seeded with 0.01 BNB, against 10,704,225 in the real v2 pool).
#
# Reference points, both measured on chain:
#   graduation opens at   17.64 WBNB   (18 BNB raise, three fork graduations)
#   the demonstrated decoy held 0.01 WBNB
# Denominated in WBNB, never BNBULL: a decoy can print its own token, not BNB.
# ZERO IS REFUSED by the contracts. Default 1 BNB.
MIN_POOL_LIQUIDITY_WBNB=1000000000000000000

# Keeper pegs, seeded at deploy so the legs are live before the first tick.
GRAVEYARD_BNBULL_PER_USD=
MARKETPLACE_BNBULL_USD=

# ── names + art ──────────────────────────────────────────────────────────
# Generated by `node scripts/gen-names.mjs`. The commitment is computed in
# Solidity from this file and passed to the Bulls constructor, where it is
# IMMUTABLE. `masterSeed` lives in it too, so the seed, the traits, the
# rarity shuffle and the names all move together or not at all.
NAMES_JSON=deployments/names.json
RARITY_JSON=deployments/rarity.json
NAMES_BATCH=50
# ONE-WAY. Only after the published table has been read back and eyeballed.
FREEZE_NAMES=
# Turns "names not published yet" from a warning into a hard failure.
REQUIRE_NAMES=

# ── game contracts (filled in at deploy, with deploy blocks) ─────────────
# ⚠ THESE ARE FOR READING, NOT FOR THE SCRIPTS. The deploy scripts read and
# write deployments/<chainid>.json and never touch this file.
BNBULL_TOKEN=
BULLS_NFT=
MINTDROP=
DUEL=
GRAVEYARD=
JACKPOT_BNBULL=
JACKPOT_BNB=
MARKETPLACE=
DEPLOY_BLOCK=

# ── keeper fleet ─────────────────────────────────────────────────────────
# drpc's free tier rejects JSON-RPC batches >3 and returns the failure as ZERO
# RESULTS, not an error. 3 is the safe ceiling. Every provider sets this.
RPC_BATCH_MAX_COUNT=3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_CHAT_ID=
SITE_URL=https://bnbulls.xyz
DRY_RUN=1
