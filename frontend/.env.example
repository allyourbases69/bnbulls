# bnbulls frontend — env template. NEVER commit the real .env.local.
# Copy to .env.local for local dev. Anything NEXT_PUBLIC_* ships to the
# browser bundle — never put a secret behind that prefix.

# ── chain (BNB Smart Chain, id 56) ──────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=56
# primary must be keyed or publicnode — NEVER the bare dataseed as sole
# primary at scale (BNB-CHAIN-FACTS.md §2). comma-separated list; first
# entry is tried first, the rest are fallbacks.
NEXT_PUBLIC_RPC_URL=https://bsc-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL_FALLBACK=https://bsc.drpc.org
NEXT_PUBLIC_EXPLORER_BASE_URL=https://bscscan.com

# optional: a WalletConnect Cloud project id. wallet connect is only wired
# up when this is set — leaving it blank is fine, injected wallets (MetaMask,
# Rabby, Binance Wallet, etc via EIP-6963) still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── game contracts ───────────────────────────────────────────────────────
# ⚠ NONE of these are deployed yet. Leave every one of these blank until a
# real deploy exists. The site MUST render an honest "not deployed yet"
# state when these are unset — inventing an address here is a real-money
# bug (see the frontend package brief, "hard constraints").
NEXT_PUBLIC_BNBULL_TOKEN=
NEXT_PUBLIC_BULLS_NFT=
NEXT_PUBLIC_MINTDROP=
NEXT_PUBLIC_DUEL=
NEXT_PUBLIC_GRAVEYARD=
NEXT_PUBLIC_JACKPOT_BNBULL=
NEXT_PUBLIC_JACKPOT_BNB=
NEXT_PUBLIC_MARKETPLACE=
# block the contracts above deployed at. bounds getLogs scans (recent pot
# awards, the graveyard's dead-bull list) so they never walk from genesis on
# a public RPC that caps block range. leave blank pre-deploy.
NEXT_PUBLIC_DEPLOY_BLOCK=

# ── the duel signer (SERVER ONLY — never NEXT_PUBLIC_) ──────────────────
# The key `/api/run-duel` signs duel results with. It must be the same address
# as `Duel.trustedSigner` on the deployment above, or every fight reverts
# InvalidSignature.
#
# ⚠ THIS IS THE MOST DANGEROUS VALUE IN THIS FILE. Whoever holds it can mint a
# signed win for any pair of bulls, up to each asset's `maxFightCostOf`. It has
# NO `NEXT_PUBLIC_` prefix, and that prefix is the only thing that decides
# whether Next inlines a variable into the browser bundle — adding one here
# publishes the key to every visitor. `src/lib/serverEnv.ts` throws at startup
# if it ever finds a NEXT_PUBLIC_*SIGNER_KEY, but do not rely on that.
#
# Chain-scoped first, then unscoped, same convention as the addresses above, so
# an anvil signer and a mainnet signer can coexist.
BNBULLS_SIGNER_KEY_56=
BNBULLS_SIGNER_KEY=

# How long a signed duel result stays submittable, in seconds. Default 180,
# bounded [30, 900]. SHORT ON PURPOSE: the BNB leg of a fight is converted from
# a dollar sticker through the chainlink feed at quote time and then frozen into
# the signature, so this window is the drift budget between the price the player
# agreed to and the dollars it is actually worth (DECISIONS.md §1). Leave blank
# for the default.
DUEL_SIGNATURE_TTL_SECONDS=

# ── socials (DECISIONS.md §5) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bnbulls.xyz
NEXT_PUBLIC_X_URL=https://x.com/WeAreBNBulls
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/WeAreBNBulls

# ── /admin operator cockpit ─────────────────────────────────────────────
# ADMIN_SESSION_SECRET (SERVER ONLY — never NEXT_PUBLIC_): the HMAC key that
# signs the /admin session cookie. Must be >= 32 chars. The gate FAILS CLOSED
# — nobody gets in — if it is unset or too short, so a forgotten secret locks
# everyone out rather than letting everyone in. Generate a strong random value
# (e.g. `openssl rand -hex 32`) and set it in .env.local locally AND on Vercel
# (Production + Preview). Never commit a real value.
#
# ⚠ On a self-hosted `next build && next start` this must be present at BUILD
# time, because Next inlines env into the Edge middleware bundle at build. On
# Vercel it is injected at runtime, so setting it in the dashboard is enough.
ADMIN_SESSION_SECRET=
# NEXT_PUBLIC_ADMIN_ADDRESSES (optional): comma-separated allow-list of admin
# wallets. Defaults to the dev wallet 0x5b1A749cc7bF1dE8ecA505769BD34Ba65f456805
# when unset. This is only the client-side "show the sign button" hint and the
# fallback server allow-list; the authoritative check is the signed cookie.
NEXT_PUBLIC_ADMIN_ADDRESSES=
